PORT=3000
DATABASE_URL=postgresql://scam:scam@postgres:5432/scam_shield?schema=public
ADMIN_TOKEN=change-me
CORS_ORIGIN=*

FREE_WEEKLY_LIMIT=3
FREE_WEEKLY_AI_LIMIT=1
REVENUECAT_WEBHOOK_AUTH=

# DeepL (Option A: classic translation)
DEEPL_AUTH_KEY=
DEEPL_API_BASE=https://api-free.deepl.com
DEEPL_TARGET_LANG=EN

# Semantic AI provider
# AI_MODE is currently used by the Ollama provider only.
AI_PROVIDER=ollama
AI_MODE=local
AI_BASE_URL=http://host.docker.internal:11434
AI_MODEL=gemma3:4b
AI_API_KEY=

# Ollama Cloud example
# AI_PROVIDER=ollama
# AI_MODE=cloud
# AI_BASE_URL=https://ollama.com
# AI_MODEL=qwen3.5:397b
# AI_API_KEY=

# OpenAI example
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=<openai-model-id>
# AI_API_KEY=

# Media forensics provider
FORENSICS_PROVIDER=hive
FORENSICS_BASE_URL=https://api.thehive.ai/api/v3
FORENSICS_MODEL=hive/ai-generated-and-deepfake-content-detection
FORENSICS_API_KEY=
