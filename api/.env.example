# Analysis routing is independent of the mobile API URL and RevenueCat.
# Local mode is rejected when NODE_ENV=production.
ANALYSIS_PROFILE=production
LOCAL_AI_BASE_URL=http://host.docker.internal:18080/v1
LOCAL_AI_MODEL=gemma4-e4b
# Local CPU speech-activity gate and experimental forensics. Ignored in production profile.
LOCAL_FORENSICS_BASE_URL=http://host.docker.internal:8081

PORT=3000
DATABASE_URL=postgresql://scam:scam@postgres:5432/scam_shield?schema=public
ADMIN_TOKEN=change-me
NODE_ENV=development
# Explicitly opt in only for local test subscriptions. Never enabled in NODE_ENV=production.
ALLOW_TEST_ADMIN=false
# A shared random secret of at least 32 characters is required for anonymous enrollment.
# Leave blank until securely configured; POST /sessions then returns 503.
SESSION_RATE_LIMIT_SECRET=
CORS_ORIGIN=*

FREE_WEEKLY_LIMIT=3
FREE_WEEKLY_AI_LIMIT=1
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_API_KEY=
REVENUECAT_ENVIRONMENT=SANDBOX
REVENUECAT_ENTITLEMENT_ID=scam_shield_pro

# Translation is independent of AI. none keeps model-generated app-language output.
DEEPL_AUTH_KEY=
DEEPL_API_BASE=https://api-free.deepl.com
TRANSLATION_PROVIDER=none
DEEPL_MODEL_TYPE=quality_optimized
# The output target comes from the app locale; EN is only internal classic normalization.

# Semantic AI provider
# AI_MODE is currently used by the Ollama provider only.
AI_PROVIDER=ollama
AI_MODE=local
AI_BASE_URL=http://host.docker.internal:11434
AI_MODEL=gemma3:4b
AI_API_KEY=
AI_MAX_OUTPUT_TOKENS=4096
AI_SEND_TEMPERATURE=true

# Ollama Cloud example
# AI_PROVIDER=ollama
# AI_MODE=cloud
# AI_BASE_URL=https://ollama.com
# AI_MODEL=qwen3.5:397b
# AI_API_KEY=

# OpenAI example
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=<openai-model-id>
# AI_API_KEY=

# Media forensics provider
FORENSICS_PROVIDER=hive
FORENSICS_BASE_URL=https://api.thehive.ai/api/v3
FORENSICS_MODEL=hive/ai-generated-and-deepfake-content-detection
FORENSICS_API_KEY=

# Media transcription provider
TRANSCRIPTION_PROVIDER=deepgram
TRANSCRIPTION_BASE_URL=https://api.eu.deepgram.com/v1
TRANSCRIPTION_MODEL=nova-3
TRANSCRIPTION_API_KEY=

# Recoverable Google identity (Firebase ID tokens, not OAuth access tokens)
ACCOUNT_IDENTITY_PROVIDER=disabled
ACCOUNT_DELETION_ENABLED=false
# Server-only Firebase Admin service-account file; never bundle in the app or commit it.
# Render Secret File path (enable deletion only after validating provider permissions):
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-admin.json
FIREBASE_AUTH_PROJECT_ID=
# Enable firebase only after configuring Google sign-in in your existing Firebase project.
TRANSCRIPTION_MAX_OUTPUT_TOKENS=4096
TRANSCRIPTION_SEND_TEMPERATURE=true
# Gemini examples and private self-hosted forensics: docs/production-provider-and-account-setup.md
